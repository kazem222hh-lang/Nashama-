<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ملحمة النشامى - كأس العالم 2026</title>

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;700;900&display=swap" rel="stylesheet">

<style>
body{
  font-family:'Cairo',sans-serif;
  background:#050811;
  color:white;
  overflow-x:hidden;
}
.fade{
  animation:fade 1s ease forwards;
}
@keyframes fade{
  from{opacity:0;transform:scale(1.1)}
  to{opacity:1;transform:scale(1)}
}
canvas{
  position:fixed;
  inset:0;
  pointer-events:none;
}
</style>
</head>

<body>

<!-- INTRO -->
<div id="intro" class="fixed inset-0 bg-black flex flex-col items-center justify-center text-center z-50">
  <h1 class="text-4xl font-black text-red-600">🇯🇴 ملحمة النشامى</h1>
  <p class="text-gray-300 mt-3">الطريق إلى كأس العالم 2026</p>
</div>

<!-- MAIN -->
<div id="app" class="hidden p-6 max-w-4xl mx-auto">

  <div class="text-center mb-4">
    <h1 class="text-2xl font-black">🇯🇴 النشامى إلى كأس العالم 2026</h1>
    <p id="countdown" class="text-green-400 mt-2"></p>
  </div>

  <!-- SCENE -->
  <div class="bg-gray-900 rounded-xl p-6 text-center shadow-xl">
    <h2 id="title" class="text-xl font-bold mb-2"></h2>
    <p id="subtitle" class="text-gray-300"></p>
    <p id="script" class="mt-4 text-yellow-400 font-bold"></p>
  </div>

  <!-- CONTROLS -->
  <div class="flex justify-center gap-3 mt-6">
    <button onclick="prev()" class="bg-gray-700 px-4 py-2 rounded">السابق</button>
    <button onclick="togglePlay()" class="bg-red-600 px-4 py-2 rounded">تشغيل</button>
    <button onclick="next()" class="bg-gray-700 px-4 py-2 rounded">التالي</button>
  </div>

  <!-- ACTIONS -->
  <div class="grid grid-cols-2 gap-3 mt-6">
    <button onclick="confetti()" class="bg-red-600 p-2 rounded">🎉 فرح</button>
    <button onclick="firework()" class="bg-green-600 p-2 rounded">🎆 نار</button>
  </div>

</div>

<canvas id="fx"></canvas>

<script>
// INTRO
setTimeout(()=>{
  document.getElementById("intro").style.display="none";
  document.getElementById("app").classList.remove("hidden");
},3000);

// COUNTDOWN
const target=new Date("2026-06-11");
setInterval(()=>{
  let d=Math.floor((target-new Date())/86400000);
  document.getElementById("countdown").innerText=`باقي ${d} يوم على كأس العالم`;
},1000);

// SCENES
const scenes=[
{
t:"بداية الحلم",
s:"جيل كامل ينتظر اللحظة",
c:"الحلم أصبح قريب..."
},
{
t:"التصفيات",
s:"معارك قوية في آسيا",
c:"النشامى لا يستسلمون"
},
{
t:"ليلة التأهل",
s:"دموع وفرح في كل مكان",
c:"الأردن إلى المونديال!"
},
{
t:"العالم ينتظر",
s:"نكتب التاريخ لأول مرة",
c:"فخر لكل أردني"
}
];

let i=0;
function show(){
document.getElementById("title").innerText=scenes[i].t;
document.getElementById("subtitle").innerText=scenes[i].s;
document.getElementById("script").innerText=scenes[i].c;
}
show();

function next(){ if(i<scenes.length-1){i++;show();confetti();} }
function prev(){ if(i>0){i--;show();} }
function togglePlay(){ next(); }

// FX
const canvas=document.getElementById("fx");
const ctx=canvas.getContext("2d");
canvas.width=window.innerWidth;
canvas.height=window.innerHeight;

let parts=[];

class P{
constructor(){
this.x=Math.random()*canvas.width;
this.y=0;
this.vx=(Math.random()-0.5)*6;
this.vy=Math.random()*5+2;
this.a=1;
}
draw(){
ctx.globalAlpha=this.a;
ctx.fillStyle="red";
ctx.fillRect(this.x,this.y,5,5);
}
update(){
this.x+=this.vx;
this.y+=this.vy;
this.a-=0.02;
}
}

function confetti(){
for(let i=0;i<80;i++) parts.push(new P());
}

function firework(){
for(let i=0;i<120;i++) parts.push(new P());
}

function loop(){
ctx.clearRect(0,0,canvas.width,canvas.height);
for(let i=parts.length-1;i>=0;i--){
parts[i].update();
parts[i].draw();
if(parts[i].a<=0) parts.splice(i,1);
}
requestAnimationFrame(loop);
}
loop();

</script>

</body>
</html>
